global proc RunAdvancedScript()
{
	catch(PorterMesh_2478bff2_0_BindFunc());
	catch(PorterMesh_2478bff2_1_BindFunc());
	catch(PorterMesh_2478bff2_2_BindFunc());
	catch(PorterMesh_2478bff2_3_BindFunc());
	catch(PorterMesh_2478bff2_4_BindFunc());
	catch(PorterMesh_2478bff2_5_BindFunc());
	catch(PorterMesh_2478bff2_6_BindFunc());
	catch(PorterMesh_2478bff2_7_BindFunc());
	catch(PorterMesh_2478bff2_8_BindFunc());
	catch(PorterMesh_2478bff2_9_BindFunc());
	catch(PorterMesh_2478bff2_10_BindFunc());
	catch(PorterMesh_2478bff2_11_BindFunc());
}

global proc NamespacePurge()
{
	string $allNodes[] = `ls`;
	for($node in $allNodes) {
		string $buffer[];
		tokenize $node ":" $buffer;
		string $newName = $buffer[size($buffer)-1];
		catchQuiet(`rename $node $newName`);
	}
}

print("Currently binding the current model, please wait...\n");
NamespacePurge();
RunAdvancedScript();
print("The model has been binded.\n");
