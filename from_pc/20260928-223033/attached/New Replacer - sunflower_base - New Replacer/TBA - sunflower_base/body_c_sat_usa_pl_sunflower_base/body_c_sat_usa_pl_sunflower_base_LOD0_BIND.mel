global proc RunAdvancedScript()
{
	catch(PorterMesh_5fd209e5_0_BindFunc());
	catch(PorterMesh_5fd209e5_1_BindFunc());
	catch(PorterMesh_5fd209e5_2_BindFunc());
	catch(PorterMesh_5fd209e5_3_BindFunc());
	catch(PorterMesh_5fd209e5_4_BindFunc());
	catch(PorterMesh_5fd209e5_5_BindFunc());
	catch(PorterMesh_5fd209e5_6_BindFunc());
	catch(PorterMesh_5fd209e5_7_BindFunc());
	catch(PorterMesh_5fd209e5_8_BindFunc());
	catch(PorterMesh_5fd209e5_9_BindFunc());
	catch(PorterMesh_5fd209e5_10_BindFunc());
	catch(PorterMesh_5fd209e5_11_BindFunc());
	catch(PorterMesh_5fd209e5_12_BindFunc());
}

global proc NamespacePurge()
{
	string $allNodes[] = `ls`;
	for($node in $allNodes) {
		string $buffer[];
		tokenize $node ":" $buffer;
		string $newName = $buffer[size($buffer)-1];
		catchQuiet(`rename $node $newName`);
	}
}

print("Currently binding the current model, please wait...\n");
NamespacePurge();
RunAdvancedScript();
print("The model has been binded.\n");
