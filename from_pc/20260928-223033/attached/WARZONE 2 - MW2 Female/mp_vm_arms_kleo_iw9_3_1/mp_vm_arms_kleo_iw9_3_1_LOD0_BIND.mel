global proc WraithMesh_56857fe3_03_BindFunc()
{
   select -r WraithMesh_56857fe3_03;
   select -add tag_wrist_attach_le;
   newSkinCluster "-toSelectedBones -mi 15 -omi true -dr 5.0 -rui false";   string $clu = findRelatedSkinCluster("WraithMesh_56857fe3_03");

   skinPercent -tv tag_wrist_attach_le 1.0 $clu WraithMesh_56857fe3_03.vtx[0:2267];
}

