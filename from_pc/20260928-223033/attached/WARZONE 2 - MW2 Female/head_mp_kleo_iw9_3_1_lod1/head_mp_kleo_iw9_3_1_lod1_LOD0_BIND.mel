global proc WraithMesh_e845650e_00_BindFunc()
{
   select -r WraithMesh_e845650e_00;
   select -add j_head;
   newSkinCluster "-toSelectedBones -mi 15 -omi true -dr 5.0 -rui false";   string $clu = findRelatedSkinCluster("WraithMesh_e845650e_00");

   skinPercent -tv j_head 1.0 $clu WraithMesh_e845650e_00.vtx[0:9651];
}

